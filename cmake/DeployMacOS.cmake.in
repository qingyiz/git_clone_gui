set(_git_clone_gui_app "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/GitCloneGui.app")

if(NOT EXISTS "${_git_clone_gui_app}/Contents/MacOS/GitCloneGui")
    message(FATAL_ERROR "待部署的应用不存在：${_git_clone_gui_app}")
endif()

set(_git_clone_gui_deploy_arguments
    "${_git_clone_gui_app}"
    -always-overwrite
)

if(NOT "$ENV{GIT_CLONE_GUI_MACOS_SIGNING_IDENTITY}" STREQUAL "")
    list(APPEND _git_clone_gui_deploy_arguments
        "-sign-for-notarization=$ENV{GIT_CLONE_GUI_MACOS_SIGNING_IDENTITY}"
    )
else()
    list(APPEND _git_clone_gui_deploy_arguments
        "-codesign=-"
    )
endif()

execute_process(
    COMMAND "@GIT_CLONE_GUI_MACDEPLOYQT@" ${_git_clone_gui_deploy_arguments}
    RESULT_VARIABLE _git_clone_gui_deploy_result
    OUTPUT_VARIABLE _git_clone_gui_deploy_output
    ERROR_VARIABLE _git_clone_gui_deploy_error
)

if(NOT _git_clone_gui_deploy_result EQUAL 0)
    message(FATAL_ERROR
        "macdeployqt 执行失败（${_git_clone_gui_deploy_result}）。\n"
        "stdout:\n${_git_clone_gui_deploy_output}\n"
        "stderr:\n${_git_clone_gui_deploy_error}"
    )
endif()

if(NOT "$ENV{GIT_CLONE_GUI_MACOS_SIGNING_IDENTITY}" STREQUAL "")
    message(STATUS "已生成并签名自包含 macOS 应用：${_git_clone_gui_app}")
else()
    message(STATUS "已生成并完成 ad-hoc Bundle 签名的自包含 macOS 应用：${_git_clone_gui_app}")
endif()
